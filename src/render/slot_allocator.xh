#pragma once

// This is a generic implementation of slot allocation. It is used for picking
// texture slots in the renderer, but could also be used more generally for:
// - picking a free slot for a new instance.
// - picking a free slot for

template <typename T, const usize N>
class SlotAllocator {
public:
    u32 require(T item);
private:
    struct entry_t {
        T item;

    };


};
